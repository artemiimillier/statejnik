# .env рабочей папки Статейника. Не коммитить. Заполняйте только нужное.

# Вордстат (частоты запросов): OAuth-токен с доступом к API Вордстата
WORDSTAT_TOKEN=

# WordPress: логин и пароль приложения (Профиль → Пароли приложений)
WP_USER=
WP_APP_PASSWORD=

# Blogger / Blogspot: OAuth-клиент Google (Desktop app) и refresh-токен
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# Вебхук (если нужен токен)
WEBHOOK_TOKEN=

# IndexNow (Яндекс, Bing): ключ, файл <ключ>.txt лежит в корне сайта
INDEXNOW_KEY=
